# EchoQuest production env template.
#
# Copy values into your hosting provider's secret store (Render dashboard,
# Vercel project settings, Fly secrets, etc). NEVER commit a populated copy.
#
# Two services consume this:
#   - apps/web (Next.js) needs the SHARED block + the WEB block
#   - apps/api (Fastify) needs the SHARED block + the API block
#
# DATABASE_URL points at a Supabase Postgres with the pgvector extension enabled.
# See DEPLOY.md for the full setup walkthrough.

# ── Shared ───────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=

# Both services use the Supabase SESSION POOLER connection string:
#   postgresql://postgres.<project-ref>:<password>@aws-<n>-<region>.pooler.supabase.com:5432/postgres
# Not the direct db.<project-ref>.supabase.co host (IPv6-only; Render has no
# outbound IPv6), and not the transaction pooler on 6543 (`prisma migrate
# deploy` needs session mode; Prisma would also need ?pgbouncer=true there).
# pgvector works through the pooler. Percent-encode special characters in
# the password (@ → %40, : → %3A, / → %2F, # → %23, % → %25, …).
#
# TLS suffix differs per service:
#   web (Prisma):        ?sslmode=require
#   api (node-postgres): ?sslmode=verify-full&sslrootcert=/etc/secrets/supabase-ca.crt
#                        (Supabase's CA as a Render Secret File), or at minimum
#                        ?sslmode=no-verify. Never ?sslmode=require for the api:
#                        pg treats it as verify-full and Supabase's CA is not in
#                        Node's trust store, so every query fails.
DATABASE_URL=

# Shared HMAC key for session, lobby and tier tokens. Set the SAME value on
# web and api (32-byte random: `openssl rand -base64 32`). The api refuses to
# boot in production when it is unset or a dev value.
SESSION_SIGNING_KEY=

CLAUDE_GM_MODEL=claude-sonnet-5-5
CLAUDE_SUMMARY_MODEL=claude-haiku-4-5-20251001
# Claude model for the web app's AI calls (game turns, Game Bible parsing,
# world wizard). Defaults to claude-sonnet-5-5. CLAUDE_GM_MODEL above is the
# api service's, checked against its own allowlist (apps/api/src/gm/model-policy.ts).
CLAUDE_WEB_GM_MODEL=claude-sonnet-5-5

# ── Web (apps/web) ───────────────────────────────────────────────────────────
NEXTAUTH_URL=https://echoquest-web.onrender.com
NEXTAUTH_SECRET=                    # 32-byte random; generate with `openssl rand -base64 32`
ADMIN_EMAILS=                       # comma-separated; these accounts get permanent Creator + /admin

# Stripe (live keys for production; webhook secret comes from `stripe listen` or dashboard)
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STORYTELLER_MONTHLY=
STRIPE_PRICE_STORYTELLER_ANNUAL=
STRIPE_PRICE_CREATOR_MONTHLY=
STRIPE_PRICE_CREATOR_ANNUAL=
# One-time AI minute credit packs (create as one-time prices in Stripe dashboard)
STRIPE_PRICE_PACK_60=
STRIPE_PRICE_PACK_180=
STRIPE_PRICE_PACK_600=

# Email (Resend; the FROM domain must be verified in the Resend dashboard)
RESEND_API_KEY=
RESEND_FROM=EchoQuest <noreply@yourdomain.com>
# Inbox for the /contact-us form
CONTACT_EMAIL=

# Web Push (generate locally: `npx web-push generate-vapid-keys`)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@yourdomain.com

# ElevenLabs (premium voices)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_NARRATOR=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_VOICE_A=AZnzlk1XvdvUeBnXmlld
ELEVENLABS_VOICE_B=VR6AewLTigWG4xSOukaG
ELEVENLABS_VOICE_C=pNInz6obpgDQGcFmaJgB

# Optional: Upstash Redis for rate limiting. Only these two enable Redis;
# unset, rate limits use the Postgres RateLimitBucket table.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── API (apps/api) ───────────────────────────────────────────────────────────
NODE_ENV=production                 # enables the production guards (signing key check, no dev token route)
PORT=4000
ALLOWED_ORIGINS=https://echoquest-web.onrender.com
TRUST_PROXY_HOPS=1                  # reverse-proxy hops in front of the api; keep 1 on Render
DATABASE_POOL_MAX=5                 # api pg pool size (default 10); ~5 on small Supabase compute
# Never set ENABLE_DEV_TIER_TOKENS in production: it mounts an unauthenticated
# tier-token route for local development.

# Speech-to-text + embeddings (all optional). Without both Deepgram values,
# POST /stt/token returns 503 and clients use on-device STT. The api's
# /tts/stream (ElevenLabs, above) needs a storyteller tier token.
DEEPGRAM_API_KEY=
DEEPGRAM_PROJECT_ID=
VOYAGE_API_KEY=
