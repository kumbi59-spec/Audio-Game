{
  "name": "audio-rpg",
  "private": true,
  "version": "0.0.0",
  "description": "Accessibility-first audio RPG platform. Audible meets AI Game Master.",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20.11.0"
  },
  "scripts": {
    "build": "pnpm -r --filter './packages/*' --filter './apps/api' --filter './apps/web' build",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "dev:api": "pnpm --filter @audio-rpg/api dev",
    "dev:mobile": "pnpm --filter @audio-rpg/mobile start",
    "dev:web": "pnpm --filter @audio-rpg/web dev",
    "security:audit:prod": "pnpm audit --prod --json",
    "security:release-gate": "node scripts/security-release-gate.mjs",
    "check:anthropic-sdk-version": "node scripts/check-anthropic-sdk-version.mjs",
    "check:parity-gate": "node scripts/check-platform-parity-gate.mjs"
  },
  "devDependencies": {
    "typescript": "5.5.4"
  },
  "pnpm": {
    "overrides": {
      "tar": "^7.5.21",
      "minimatch": "^9.0.9",
      "postcss": "^8.5.18",
      "send": "^1.2.1",
      "@xmldom/xmldom": "^0.8.15",
      "@anthropic-ai/sdk": "^0.91.0",
      "find-my-way@^9": "^9.7.0",
      "fast-uri@^3": "^3.1.7",
      "@fastify/busboy@^3": "^3.2.1",
      "undici@^6": "^6.28.1",
      "shell-quote@^1": "^1.9.0",
      "form-data@^3": "^3.0.5",
      "source-map-js@^1": "^1.2.2",
      "brace-expansion@^2": "^2.1.6",
      "nanoid@^3": "^3.3.18",
      "compression@^1": "^1.8.2",
      "browserslist@^4": "^4.28.7",
      "joi@^17": "^17.13.7",
      "ws@^6": "^6.2.4",
      "ws@^7": "^7.5.11",
      "ws@^8": "^8.21.0",
      "js-yaml@^3": "^3.15.2",
      "js-yaml@^4": "^4.3.2",
      "@babel/plugin-transform-modules-systemjs@^7": "^7.29.4",
      "@remix-run/server-runtime@^2": "^2.17.5",
      "@auth/core@^0.41": "^0.41.3",
      "sharp@^0.34": "^0.35.5"
    }
  }
}
