# ── AI / LLM ─────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
ELEVENLABS_API_KEY=

# Models (override defaults)
CLAUDE_GM_MODEL=claude-sonnet-5-5
CLAUDE_SUMMARY_MODEL=claude-haiku-4-5-20251001
# Claude model for the web app's AI calls (game turns, Game Bible parsing,
# world wizard). Defaults to claude-sonnet-5-5. CLAUDE_GM_MODEL above is the
# api service's, checked against its own allowlist (apps/api/src/gm/model-policy.ts).
CLAUDE_WEB_GM_MODEL=claude-sonnet-5-5

# ── AI cover art (optional; falls back to deterministic SVG if unset) ────────
# Set IMAGE_GEN_PROVIDER to enable AI image generation for world covers.
# Two providers supported — pick one:
#   replicate  hosted inference via Replicate (~$0.003/image, fast)
#   bfl        direct Black Forest Labs API (~$0.04/image, higher quality)
IMAGE_GEN_PROVIDER=
# --- Replicate (IMAGE_GEN_PROVIDER=replicate) ---
REPLICATE_API_TOKEN=
REPLICATE_IMAGE_MODEL=black-forest-labs/flux-schnell
# --- Black Forest Labs (IMAGE_GEN_PROVIDER=bfl) ---
BFL_API_KEY=
# Optional: region override (default: https://api.bfl.ai/v1)
BFL_API_BASE=
# Optional: model override (default: black-forest-labs/flux-dev)
BFL_MODEL_NAME=

# ── Site URL (used for SEO: sitemap, canonical URLs, OG images) ───────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Google Analytics 4 measurement ID. Leave empty locally so dev traffic stays
# out of the production property.
NEXT_PUBLIC_GA_ID=

# ── Ads (Google AdSense — optional; shows upgrade prompt if unset) ────────────
# Free-tier users see ad banners. Sign up at adsense.google.com to get these.
NEXT_PUBLIC_ADSENSE_PUB_ID=
NEXT_PUBLIC_ADSENSE_SLOT=

# ── Speech-to-Text ────────────────────────────────────────────────────────────
DEEPGRAM_API_KEY=
DEEPGRAM_PROJECT_ID=

# ── Embeddings ────────────────────────────────────────────────────────────────
VOYAGE_API_KEY=

# ── Infrastructure ────────────────────────────────────────────────────────────
# Local Postgres + pgvector from docker-compose.yml (`docker compose up -d postgres`).
# One URL serves both apps: Prisma (web) reads ?schema=web and keeps its tables
# in the "web" schema, so `prisma migrate dev` never sees the api's tables; the
# api ignores the parameter and creates its tables in public. Keep it the same
# as apps/web/prisma/.env, which is what the Prisma CLI reads. Leave it unset
# in the repo-root .env for the api to use its in-memory store instead.
DATABASE_URL=postgres://audio_rpg:audio_rpg@localhost:5432/audio_rpg?schema=web
# Optional: Upstash Redis for the web app's rate limits. Only these two enable
# Redis; unset, rate limits use the Postgres RateLimitBucket table.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── API server (apps/api) ─────────────────────────────────────────────────────
PORT=4000
# Shared by web and api (lobby, session and tier tokens). This dev-only value
# is the default both apps fall back to; production needs a real secret, the
# same on both, and the api refuses to boot with this value there.
SESSION_SIGNING_KEY=dev-insecure-change-me
ALLOWED_ORIGINS=http://localhost:8081,http://localhost:19006,http://localhost:3000
# Reverse-proxy hops in front of the api (per-IP rate limits read the client
# IP through them). 0 trusts no X-Forwarded-For; keep 1 on Render.
# TRUST_PROXY_HOPS=1
# Dev only: mounts POST /auth/token, which mints any tier token without auth.
# Ignored when NODE_ENV=production; never set it in production.
# ENABLE_DEV_TIER_TOKENS=true
# api pg pool size (default 10); ~5 on small Supabase compute.
# DATABASE_POOL_MAX=10

# ── Web app (apps/web) ────────────────────────────────────────────────────────
# Database variable is DATABASE_URL (shared by web + api; see Infrastructure).
NEXTAUTH_SECRET=change-me-in-prod
NEXTAUTH_URL=http://localhost:3000

# Stripe (web payments; leave empty to disable checkout, e.g. sk_test_... / price_...)
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STORYTELLER_MONTHLY=
STRIPE_PRICE_STORYTELLER_ANNUAL=
STRIPE_PRICE_CREATOR_MONTHLY=
STRIPE_PRICE_CREATOR_ANNUAL=
# One-time AI minute credit packs (create as one-time prices in Stripe)
STRIPE_PRICE_PACK_60=
STRIPE_PRICE_PACK_180=
STRIPE_PRICE_PACK_600=

# RevenueCat (mobile payments; appl_... / goog_...)
REVENUECAT_APPLE_API_KEY=
REVENUECAT_GOOGLE_API_KEY=

# Email (Resend; leave empty to disable sending, e.g. re_...)
RESEND_API_KEY=
RESEND_FROM=EchoQuest <noreply@echoquest.app>
# Inbox for the /contact-us form (sent through Resend). Unset, the form tells
# people to email instead.
CONTACT_EMAIL=

# Admin access (comma-separated emails) — these accounts always get
# Creator tier + access to /admin regardless of their stored DB tier.
ADMIN_EMAILS=admin@echoquest.app

# Admin seeder (used by `pnpm --filter @audio-rpg/web db:seed:admin`).
# Put real values ONLY in apps/web/.env.local — never commit them.
ADMIN_SEED_EMAIL=
ADMIN_SEED_PASSWORD=
ADMIN_SEED_NAME=

# Web Push (VAPID) — generate keys: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@echoquest.app

# Optional: monthly ElevenLabs narration caps by paid tier
ELEVENLABS_STORYTELLER_MONTHLY_CHAR_CAP=40000
ELEVENLABS_CREATOR_MONTHLY_CHAR_CAP=90000

# ── ElevenLabs server-side voice IDs (apps/api) ───────────────────────────────
# Override the default narrator and NPC voices used by the API TTS route.
# Leave unset to use built-in defaults (Rachel, Domi, Arnold, Grace).
# Find voice IDs at: https://elevenlabs.io/voice-library
ELEVENLABS_VOICE_NARRATOR=
ELEVENLABS_VOICE_A=
ELEVENLABS_VOICE_B=
ELEVENLABS_VOICE_C=
